.env
.env.*
!.env.example

# Python/build caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/

# Generated source checkouts and task output
work/
tasks/
*.tar.gz

# Run logs/checkpoints and local roll configs.
# Batch configs are per-run scratch: they name an output directory, a ledger and a language, and a
# repository full of them says nothing a reader needs. `example-run.yaml` is the one that is kept,
# because the README points at it.
*.log
*.jsonl
*.yaml
!example-run.yaml
!.github/**/*.yaml
jobs/
.frf-*/
.harbor/

# Coverage build artefacts
frf/observe/coverage/agents/*.so
