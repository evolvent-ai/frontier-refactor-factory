# Copy to .env and fill in. .env is gitignored; nothing in it is ever committed.
#
# Credentials are read from the environment first and from .env second, by exactly one function.
# Two readers of the same secret is one more than a reader can keep straight, and it decides whether
# a run works based on how it happened to be launched.

# The model gateway. OpenAI-compatible; the factory only ever sends chat completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Sandboxes. Optional: without it the factory uses a local Docker daemon, and says so when there is
# neither.
E2B_API_KEY=

# Raises the GitHub search rate limit from 10 to 30 requests/minute. Sourcing is the only thing that
# reads it, and it degrades to unauthenticated rather than failing.
GITHUB_TOKEN=
